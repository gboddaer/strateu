diff --git a/src/kolibri/kolibri_engine.cu b/src/kolibri/kolibri_engine.cu
index 597a57d2..149b234f 100644
--- a/src/kolibri/kolibri_engine.cu
+++ b/src/kolibri/kolibri_engine.cu
@@ -5691,13 +5691,21 @@ static long long slots_sum_stride(const Engine& e) {
 // One expert's blob into one device slot, for every layer: n_layers memcpys of stride bytes, queued on the engine's
 // stream.  Asynchronous on purpose: the copies are ordered behind every kernel already launched on g_st (which read
 // the OLD occupants) and ahead of the next token's kernels, so a round neither drains the device nor waits per move.
-static void slot_promote(Engine& e, int id, int slot) {
+static bool promote_batch_on() {
+    static const bool on = env_on("STRATA_KOLIBRI_PROMOTE_BATCH");
+    return on;
+}
+
+// batch=true is set only for a whole slots_reselect move list: the caller records one old-reader dependency before
+// the list and one readiness dependency after it.  Every copy still goes through the ring's single copy stream, so
+// the final event covers all of them.  hstage (no ring) keeps its per-move sync, where the next pack reuses it.
+static void slot_promote(Engine& e, int id, int slot, bool batch = false) {
     for (auto& b : e.blobs) {
         if (e.transfer) {
-            e.transfer->wait_for(g_st);   // old slot consumers finish before the copy stream overwrites it
+            if (!batch) e.transfer->wait_for(g_st);   // old slot consumers finish before the copy stream overwrites it
             pack_blob(b, e.g, id, e.transfer->acquire());
             e.transfer->submit(b.dev + b.stride * (size_t) slot, b.stride);
-            e.transfer->wait_on(g_st);
+            if (!batch) e.transfer->wait_on(g_st);
             continue;
         }
         if (e.no_pin) {   // pack into the staging blob, then one H2D from it; there is no pinned source
@@ -5713,13 +5721,13 @@ static void slot_promote(Engine& e, int id, int slot) {
 
 // The same move for ONE layer: 1 queued copy of stride bytes (2.21 MB at this model).  The source is the PINNED host
 // table (LayerBlobs::table), so the copy is a real async DMA rather than a staged one.
-static void slot_promote_layer(Engine& e, int64_t l, int id, int slot) {
+static void slot_promote_layer(Engine& e, int64_t l, int id, int slot, bool batch = false) {
     LayerBlobs& b = e.blobs[(size_t) l];
     if (e.transfer) {
-        e.transfer->wait_for(g_st);
+        if (!batch) e.transfer->wait_for(g_st);
         pack_blob(b, e.g, id, e.transfer->acquire());
         e.transfer->submit(b.dev + b.stride * (size_t) slot, b.stride);
-        e.transfer->wait_on(g_st);
+        if (!batch) e.transfer->wait_on(g_st);
         return;
     }
     if (e.no_pin) {
@@ -6017,10 +6025,20 @@ static void slots_reselect(Engine& e, const char* why = nullptr, int budget = -1
     // (the 2,699-move round measured on 2026-10-27).  This is the Qwen3.8-Flash-Next engine's ordering: copies on the
     // engine's own stream, joined once.
     const auto t0 = Clock::now();
+    const bool batch = promote_batch_on() && e.transfer != nullptr && !dec_stream_on() && !dec_handoff_on();
+    if (batch) {
+        static bool traced = false;
+        if (!traced) {
+            traced = true;
+            std::fprintf(stderr, "strata-kolibri: promotion batch: one reader fence and one readiness fence per round\n");
