diff --git a/tests/kolibri/expert_transfer_test.cu b/tests/kolibri/expert_transfer_test.cu
index 7f65f5bc..78d805c4 100644
--- a/tests/kolibri/expert_transfer_test.cu
+++ b/tests/kolibri/expert_transfer_test.cu
@@ -7,6 +7,7 @@
 #include <cstdio>
 
 static void ck(cudaError_t e) { if (e != cudaSuccess) throw std::runtime_error(cudaGetErrorString(e)); }
+static void batch_round_test(bool pinned);
 int main() {
     constexpr size_t cap = 8192;
     unsigned char* dev = nullptr;
@@ -73,5 +74,60 @@ int main() {
         for (auto x : host) if (x != 231) throw std::runtime_error("reset/replay copied stale weights");
     }
     ck(cudaFree(dev));
+    for (bool pinned : {false, true}) batch_round_test(pinned);
     std::puts("PASS pageable/pinned transfer ring: delayed DMA, wraparound, partial layouts, bounds, drain");
 }
+
+// Task 6: one reader fence before a multi-move round, one readiness fence after it, two ring buffers, then a new
+// generation and a second consumer stream.  The old readers must finish before either destination is overwritten;
+// the new consumer must not read a half-published round.
+static void batch_round_test(bool pinned) {
+    constexpr size_t cap = 4096;
+    unsigned char* dev = nullptr;
+    ck(cudaMalloc((void**)&dev, 4 * cap));
+    strata::kolibri::ExpertTransfer ring(cap, pinned);
+    unsigned char *obs0 = nullptr, *obs1 = nullptr;
+    ck(cudaHostAlloc((void**)&obs0, cap, cudaHostAllocDefault));
+    ck(cudaHostAlloc((void**)&obs1, cap, cudaHostAllocDefault));
+    ck(cudaMemset(dev, 7, 2 * cap));
+    cudaStream_t reader = nullptr, other = nullptr;
+    ck(cudaStreamCreateWithFlags(&reader, cudaStreamNonBlocking));
+    ck(cudaStreamCreateWithFlags(&other, cudaStreamNonBlocking));
+    ck(cudaLaunchHostFunc(reader, [](void*) { std::this_thread::sleep_for(std::chrono::milliseconds(10)); }, nullptr));
+    ck(cudaMemcpyAsync(obs0, dev, cap, cudaMemcpyDeviceToHost, reader));
+    ck(cudaMemcpyAsync(obs1, dev + cap, cap, cudaMemcpyDeviceToHost, reader));
+    ring.wait_for(reader);                       // the one prior-reader fence covers both old readers
+    std::memset(ring.acquire(), 11, cap);
+    ring.submit(dev, cap);
+    std::memset(ring.acquire(), 12, cap);
+    ring.submit(dev + cap, cap);
+    ring.wait_on(nullptr);                       // the last copy event covers the whole round
+    ck(cudaStreamSynchronize(nullptr));
+    ck(cudaStreamSynchronize(reader));
+    for (size_t j = 0; j < cap; ++j) {
+        if (obs0[j] != 7 || obs1[j] != 7) throw std::runtime_error("batch overwrote an old reader");
+    }
+    unsigned char host[cap];
+    ck(cudaMemcpy(host, dev, cap, cudaMemcpyDeviceToHost));
+    for (size_t j = 0; j < cap; ++j) if (host[j] != 11) throw std::runtime_error("batch destination 0 wrong");
+    ck(cudaMemcpy(host, dev + cap, cap, cudaMemcpyDeviceToHost));
+    for (size_t j = 0; j < cap; ++j) if (host[j] != 12) throw std::runtime_error("batch destination 1 wrong");
+    // A second consumer stream, and a following generation, must see the whole new round and no stale bytes.
+    ring.wait_for(nullptr);
+    std::memset(ring.acquire(), 21, cap);
+    ring.submit(dev, cap);
+    std::memset(ring.acquire(), 22, cap);
+    ring.submit(dev + cap, cap);
+    ring.wait_on(other);
+    ck(cudaMemcpyAsync(obs0, dev, cap, cudaMemcpyDeviceToHost, other));
+    ck(cudaMemcpyAsync(obs1, dev + cap, cap, cudaMemcpyDeviceToHost, other));
+    ck(cudaStreamSynchronize(other));
+    for (size_t j = 0; j < cap; ++j) {
+        if (obs0[j] != 21 || obs1[j] != 22) throw std::runtime_error("second stream/generation saw stale weights");
+    }
+    ck(cudaStreamDestroy(reader));
+    ck(cudaStreamDestroy(other));
+    ck(cudaFreeHost(obs0));
+    ck(cudaFreeHost(obs1));
+    ck(cudaFree(dev));
+}
